<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark application theme for Material3 -->
    <style name="Base.Theme.BanHangSo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sky_blue</item>
        <item name="colorPrimaryVariant">@color/azure</item>
        <item name="colorPrimaryContainer">@color/midnight_blue</item>
        <item name="colorOnPrimaryContainer">@color/pale_blue</item>
        <item name="colorOnPrimary">@color/dark_background</item>

        <item name="colorSecondary">@color/light_purple</item>
        <item name="colorSecondaryVariant">@color/fuchsia</item>
        <item name="colorSecondaryContainer">@color/amethyst</item>
        <item name="colorOnSecondary">@color/dark_background</item>

        <item name="colorAccent">@color/mint</item>

        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_text_primary</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/dark_background</item>

        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorHint">@color/dark_text_hint</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.BanHangSo" parent="Base.Theme.BanHangSo" />

    <!-- Button styles -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sky_blue</item>
        <item name="android:textColor">@color/dark_background</item>
    </style>

    <style name="Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/sky_blue</item>
        <item name="android:textColor">@color/sky_blue</item>
    </style>

    <style name="Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mint</item>
        <item name="android:textColor">@color/dark_background</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
