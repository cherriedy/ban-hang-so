<resources>
    <!-- Base application theme for Material3 -->
    <style name="Base.Theme.BanHangSo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/azure</item>
        <item name="colorPrimaryVariant">@color/sapphire</item>
        <item name="colorPrimaryContainer">@color/pale_blue</item>
        <item name="colorOnPrimaryContainer">@color/midnight_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/purple_heart</item>
        <item name="colorSecondaryVariant">@color/amethyst</item>
        <item name="colorSecondaryContainer">@color/light_purple</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorAccent">@color/fuchsia</item>

        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/light_text_primary</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:textColor">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
        <item name="android:textColorHint">@color/light_text_hint</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.BanHangSo" parent="Base.Theme.BanHangSo" />

    <!--     Other UI component styles -->
    <style name="RoundedBorderShapeableImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/light_text_primary</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Button styles -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/azure</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/azure</item>
        <item name="android:textColor">@color/azure</item>
    </style>

    <style name="Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fuchsia</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.BanHangSo.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.BanHangSo</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_app_launcher</item>
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
    </style>
</resources>
