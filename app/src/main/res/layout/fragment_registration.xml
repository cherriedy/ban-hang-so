<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <import type="com.optlab.banhangso.internal.utilities.Constants" />

        <variable
            name="viewModel"
            type="com.optlab.banhangso.features.main.authentication.viewmodel.RegistrationViewModel" />

        <variable
            name="fragment"
            type="com.optlab.banhangso.features.main.authentication.view.RegistrationFragment" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/mtb"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@drawable/bg_top_dashboard"
                app:contentInsetStartWithNavigation="0dp"
                app:navigationIcon="@drawable/ic_left_arrow"
                app:navigationIconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginTop="@dimen/spacing_smlarge"
                android:layout_marginBottom="@dimen/spacing_smlarge"
                android:fontFamily="@font/open_sans"
                android:text="@string/contact_information"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textFontWeight="800" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:text="@string/contact_name"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        app:syncFocusColor="@{tieContactName}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/asterisk"
                        android:textColor="?attr/colorError" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginEnd="@dimen/spacing_large"
                    android:background="@color/white"
                    app:endIconMode="clear_text"
                    app:error="@{viewModel.errors[Constants.Auth.ERROR_USER_NAME]}"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tie_contact_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/hint_contact_name"
                        android:inputType="text"
                        android:maxLines="1"
                        android:text="@={viewModel.inputFields[Constants.Auth.KEY_USER_NAME]}"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="@color/raven"
                        android:textFontWeight="800" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:text="@string/phone_number"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    app:syncFocusColor="@{tiePhoneNumber}" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginEnd="@dimen/spacing_large"
                    android:background="@color/white"
                    app:endIconMode="clear_text"
                    app:error="@{viewModel.errors[Constants.Auth.ERROR_USER_PHONE]}"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tie_phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/hint_phone_number"
                        android:inputType="phone"
                        android:text="@={viewModel.inputFields[Constants.Auth.KEY_USER_PHONE]}"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="@color/raven"
                        android:textFontWeight="800" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginTop="@dimen/spacing_mlarge"
                    android:layout_marginEnd="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_smlarge">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/store_information"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800"
                        tools:ignore="RelativeOverlap" />

                    <RadioGroup
                        android:id="@+id/tg_role"
                        android:layout_width="155dp"
                        android:layout_height="38dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_radio_group_rounded"
                        android:gravity="center"
                        android:onCheckedChanged="@{fragment::onUserRoleSelected}"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/mrb_store_owner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_medium"
                            android:layout_weight="0.5"
                            android:background="@drawable/selector_role_radio"
                            android:button="@android:color/transparent"
                            android:checked="true"
                            android:fontFamily="@font/open_sans"
                            android:gravity="center"
                            android:text="@string/store_owner"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorPrimary"
                            android:textFontWeight="800" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/mrb_employee"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:background="@drawable/selector_role_radio"
                            android:button="@android:color/transparent"
                            android:fontFamily="@font/open_sans"
                            android:gravity="center"
                            android:text="@string/employee"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/million_gray"
                            android:textFontWeight="800" />

                    </RadioGroup>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/ll_store_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.isAdmin ? View.VISIBLE : View.GONE}">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_large"
                            android:layout_marginBottom="@dimen/spacing_medium"
                            android:text="@string/store_name"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            app:syncFocusColor="@{tieStoreName}" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:text="@string/asterisk"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginEnd="@dimen/spacing_large"
                        android:background="@color/white"
                        app:endIconMode="clear_text"
                        app:error="@{viewModel.errors[Constants.Auth.ERROR_STORE_NAME]}"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tie_store_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans"
                            android:hint="@string/hint_store_name"
                            android:inputType="text"
                            android:maxLines="1"
                            android:text="@={viewModel.inputFields[Constants.Auth.KEY_STORE_NAME]}"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/raven"
                            android:textFontWeight="800" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_store_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.isAdmin ? View.VISIBLE : View.GONE}">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_large"
                            android:layout_marginBottom="@dimen/spacing_medium"
                            android:text="@string/description"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            app:syncFocusColor="@{tieStoreDescription}" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:text="@string/asterisk"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginEnd="@dimen/spacing_large"
                        android:background="@color/white"
                        app:endIconMode="clear_text"
                        app:error="@{viewModel.errors[Constants.Auth.ERROR_STORE_DESCRIPTION]}"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tie_store_description"
                            android:layout_width="match_parent"
                            android:layout_height="175dp"
                            android:fontFamily="@font/open_sans"
                            android:gravity="top"
                            android:hint="@string/hint_store_description"
                            android:inputType="textMultiLine"
                            android:text="@={viewModel.inputFields[Constants.Auth.KEY_STORE_DESCRIPTION]}"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/raven"
                            android:textFontWeight="800" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_store_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.isAdmin ? View.GONE : View.VISIBLE}">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_large"
                            android:layout_marginBottom="@dimen/spacing_medium"
                            android:text="@string/store_code"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:text="@string/asterisk"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_large"
                        android:layout_marginEnd="@dimen/spacing_large"
                        android:background="@color/white"
                        app:endIconMode="clear_text"
                        app:error="@{viewModel.errors[Constants.Auth.ERROR_STORE_CODE]}"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans"
                            android:inputType="text"
                            android:maxLines="1"
                            android:text="@={viewModel.inputFields[Constants.Auth.KEY_STORE_CODE]}"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textColor="@color/raven"
                            android:textFontWeight="800" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cb_agree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/spacing_large"
                android:onCheckedChanged="@{(_, isChecked) -> viewModel.validateTermsAndConditions(isChecked)}"
                android:text="@string/agree_with_terms_and_cons" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mb_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_middle"
                android:enabled="@{viewModel.canRegister}"
                android:fontFamily="@font/open_sans"
                android:onClick="@{viewModel::onSignUp}"
                android:text="@string/complete"
                android:textFontWeight="800"
                app:cornerRadius="@dimen/spacing_medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_mxlarge"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/already_have_account"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textFontWeight="800" />

                <View
                    android:layout_width="@dimen/spacing_medium"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/tv_sign_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:onClick="@{fragment::onSignInTextClick}"
                    android:text="@string/sign_in"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textFontWeight="800" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
