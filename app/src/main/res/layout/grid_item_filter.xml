<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="filter"
            type="com.optlab.banhangso.models.application.BaseFilter"/>
    </data>

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:clickable="true"
        android:text="@{filter.name}"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        app:checkedIconVisible="true"
        app:chipBackgroundColor="?attr/colorSurface"
        app:chipCornerRadius="@dimen/spacing_xmedium"
        app:chipStrokeColor="?attr/colorPrimary"
        app:chipStrokeWidth="1dp"
        app:closeIconEnabled="false"
        tools:text="Today" />

</layout>