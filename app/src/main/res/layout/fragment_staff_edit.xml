<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.optlab.banhangso.features.main.staff.Constants" />

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.optlab.banhangso.features.main.staff.viewmodels.StaffEditViewModel" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/athens_gray"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_dashboard"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnBackground" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans"
                android:text="@string/attr_avatar"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textFontWeight="800"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/civ_avatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="@dimen/spacing_large"
                android:scaleType="centerCrop"
                app:civ_border_color="@color/athens_gray"
                app:civ_border_width="1dp"
                app:imageResource="@{viewModel.staff.imageUrl}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_avatar"
                tools:src="@tools:sample/avatars" />

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="btn_upload_images,btn_take_picture"
                app:flow_horizontalAlign="start"
                app:flow_horizontalGap="@dimen/spacing_middle"
                app:flow_wrapMode="none"
                app:layout_constraintBottom_toBottomOf="@id/civ_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/civ_avatar"
                app:layout_constraintTop_toTopOf="@id/civ_avatar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/transparent"
                android:padding="16dp"
                android:text="@string/attr_upload_image"
                android:textColor="@color/mariner"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_add_image"
                app:iconGravity="start"
                app:iconTint="@color/mariner"
                app:strokeColor="@color/mariner"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_take_picture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/transparent"
                android:padding="16dp"
                android:text="@string/attr_take_a_pic"
                android:textColor="@color/mariner"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_take_new_photo"
                app:iconGravity="start"
                app:iconTint="@color/mariner"
                app:strokeColor="@color/mariner"
                app:strokeWidth="1dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_mxlarge"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_large"
                android:fontFamily="@font/open_sans"
                android:text="@string/attr_staff_info"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textFontWeight="800" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xmedium">

                    <TextView
                        android:id="@+id/tv_title_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:text="@string/attr_staff_name"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/raven"
                        android:textFontWeight="800"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:syncFocusColor="@{etName}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_toEndOf="@id/tv_title_name"
                        android:fontFamily="@font/open_sans"
                        android:text="@string/asterisk"
                        android:textColor="@color/red"
                        android:textFontWeight="800"
                        app:layout_constraintBottom_toBottomOf="@id/tv_title_name"
                        app:layout_constraintStart_toEndOf="@id/tv_title_name" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="clear_text"
                    app:error="@{viewModel.errors[Constants.ERROR_NAME]}"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/hint_contact_name"
                        android:inputType="text"
                        android:text="@={viewModel.staff.name}"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800"
                        tools:text="@tools:sample/full_names" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xmedium">

                    <TextView
                        android:id="@+id/tv_title_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:text="@string/email"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/raven"
                        android:textFontWeight="800"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:syncFocusColor="@{etEmail}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_toEndOf="@id/tv_title_email"
                        android:fontFamily="@font/open_sans"
                        android:text="@string/asterisk"
                        android:textColor="@color/red"
                        android:textFontWeight="800"
                        app:layout_constraintBottom_toBottomOf="@id/tv_title_email"
                        app:layout_constraintStart_toEndOf="@id/tv_title_email" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="clear_text"
                    app:error="@{viewModel.errors[Constants.ERROR_EMAIL]}"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="@{!viewModel.isEditing}"
                        android:fontFamily="@font/open_sans"
                        android:inputType="none"
                        android:text="@={viewModel.staff.email}"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800"
                        tools:text="@string/hint_email" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xmedium"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/phone_number"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="@color/raven"
                    android:textFontWeight="800"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:syncFocusColor="@{etPhone}" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="clear_text"
                    app:error="@{viewModel.errors[Constants.ERROR_PHONE]}"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/hint_phone_number"
                        android:inputType="phone|number"
                        android:text="@={viewModel.staff.phone}"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layout_action_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_large">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/open_sans"
                android:onClick="@{viewModel::onDelete}"
                android:padding="@dimen/spacing_large"
                android:text="@string/delete"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorError"
                android:textFontWeight="800"
                android:visibility="@{viewModel.isEditing ? View.VISIBLE : View.GONE}"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="@dimen/spacing_medium"
                app:strokeColor="?attr/colorError"
                app:strokeWidth="1dp" />

            <Space
                android:id="@+id/tl_login_method"
                android:layout_width="16dp"
                android:layout_height="0dp"
                android:visibility="@{viewModel.isEditing ? View.VISIBLE : View.GONE}" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/boston_blue"
                android:enabled="@{viewModel.canSubmit}"
                android:fontFamily="@font/open_sans"
                android:onClick="@{viewModel.isEditing ? viewModel::onUpdate : viewModel::onCreate}"
                android:padding="@dimen/spacing_large"
                android:text="@{viewModel.isEditing ? @string/update : @string/complete}"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textFontWeight="800"
                app:cornerRadius="@dimen/spacing_medium" />

        </LinearLayout>

    </LinearLayout>

</layout>