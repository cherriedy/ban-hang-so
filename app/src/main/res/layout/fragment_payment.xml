<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.optlab.banhangso.features.main.sale.viewmodels.SaleViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/athens_gray"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mtb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_dashboard"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnPrimarySurface"
            app:title="@string/payment"
            app:titleTextColor="?attr/colorOnPrimarySurface" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:paddingHorizontal="@dimen/spacing_mlarge"
                    android:paddingVertical="@dimen/spacing_mxlarge"
                    android:text="@string/payment_information"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textFontWeight="800" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_prices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:padding="@dimen/spacing_mlarge">

                    <TextView
                        android:id="@+id/tv_selling_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:text="Giá bán gốc: "
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:maxLines="1"
                        android:text="@{viewModel.cart.displayTotalSellingPrice}"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textFontWeight="800"
                        app:layout_constraintBottom_toBottomOf="@id/tv_selling_price"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_selling_price"
                        tools:text="100.000 VND" />

                    <TextView
                        android:id="@+id/tv_discount_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:fontFamily="@font/open_sans"
                        android:text="Khuyến mãi: "
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_selling_price" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:maxLines="1"
                        android:text="@{viewModel.cart.displayTotalDiscountPrice}"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textFontWeight="800"
                        app:layout_constraintBottom_toBottomOf="@id/tv_discount_price"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_discount_price"
                        tools:text="80.000 VND" />


                    <TextView
                        android:id="@+id/tv_final_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:fontFamily="@font/open_sans"
                        android:text="@string/final_price"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textFontWeight="800"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_discount_price" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans"
                        android:maxLines="1"
                        android:text="@{viewModel.cart.displayFinalPrices}"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="?attr/colorPrimary"
                        android:textFontWeight="800"
                        app:layout_constraintBottom_toBottomOf="@id/tv_final_price"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_final_price"
                        tools:text="80.000 VND" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:paddingHorizontal="@dimen/spacing_mlarge"
                    android:paddingVertical="@dimen/spacing_mxlarge"
                    android:text="@string/payment_method"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textFontWeight="800" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_methods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3"
                    tools:itemCount="5"
                    tools:listitem="@layout/list_item_payment_method" />

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="end"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{viewModel::onPay}"
                android:text="@string/complete"
                app:cornerRadius="@dimen/spacing_xmedium" />

        </LinearLayout>

    </LinearLayout>

</layout>