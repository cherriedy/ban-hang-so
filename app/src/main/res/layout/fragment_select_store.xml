<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="fragment"
            type="com.optlab.banhangso.features.main.store.view.SelectStoreFragment" />

        <variable
            name="viewModel"
            type="com.optlab.banhangso.features.main.store.viewmodel.SelectStoreViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mtb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_top_dashboard"
            android:fontFamily="@font/open_sans"
            android:textFontWeight="800"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white"
            app:title="@string/choose_store"
            app:titleTextColor="@color/white" />

        <TextView
            android:id="@+id/tv_choose_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/mtb"
            android:layout_marginStart="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_large"
            android:fontFamily="@font/open_sans"
            android:text="@string/choose_one_store"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/black"
            android:textFontWeight="800" />

        <TextView
            android:id="@+id/tv_chain_stores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_choose_store"
            android:layout_marginStart="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_middle"
            android:fontFamily="@font/open_sans"
            android:text="@{@string/chain_of_stores + ` ` + viewModel.user.name}"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/black"
            android:textFontWeight="800" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mb_add_store"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/spacing_large"
            android:layout_marginEnd="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_large"
            android:onClick="@{fragment}"
            android:padding="@dimen/spacing_large"
            android:text="@string/add_store"
            app:cornerRadius="@dimen/spacing_medium" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swStores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/mb_add_store"
            android:layout_below="@id/tv_chain_stores"
            app:swipeRefreshLayoutProgressSpinnerBackgroundColor="?attr/colorPrimary">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/spacing_middle"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_large"
                    android:paddingEnd="@dimen/spacing_large"
                    android:paddingBottom="@dimen/spacing_large">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_stores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="2"
                        tools:listitem="@layout/list_item_store" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </RelativeLayout>

</layout>
