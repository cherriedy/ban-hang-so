<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_navigation"
    app:startDestination="@id/authenticationFragment">

    <fragment
        android:id="@+id/authenticationFragment"
        android:name="com.optlab.banhangso.features.main.authentication.view.AuthenticationFragment"
        tools:layout="@layout/fragment_authentication">

        <deepLink app:uri="app://banhangso/auth/login" />

        <action
            android:id="@+id/action_authentication_to_selectStore"
            app:destination="@id/selectStoreFragment"
            app:enterAnim="@anim/anim_slide_in_right"
            app:exitAnim="@anim/anim_slide_out_left"
            app:popEnterAnim="@anim/anim_slide_in_left"
            app:popExitAnim="@anim/anim_slide_out_right" />

        <action
            android:id="@+id/action_authentication_to_registration"
            app:destination="@id/registrationFragment"
            app:enterAnim="@anim/anim_slide_in_right"
            app:exitAnim="@anim/anim_slide_out_left"
            app:popEnterAnim="@anim/anim_slide_in_left"
            app:popExitAnim="@anim/anim_slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.optlab.banhangso.features.main.authentication.view.RegistrationFragment"
        tools:layout="@layout/fragment_registration">

        <deepLink app:uri="app://banhangso/auth/register" />

        <argument
            android:name="email"
            app:argType="string" />

        <argument
            android:name="password"
            app:argType="string" />

        <action
            android:id="@+id/action_to_store_select"
            app:destination="@id/selectStoreFragment"
            app:enterAnim="@anim/anim_slide_in_right"
            app:exitAnim="@anim/anim_slide_out_left"
            app:popEnterAnim="@anim/anim_slide_in_left"
            app:popExitAnim="@anim/anim_slide_out_right" />
    </fragment>

</navigation>
