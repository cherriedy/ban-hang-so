<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_product_tabs"
    app:startDestination="@id/productTabHostFragment">

    <action
        android:id="@+id/action_to_product_edit"
        app:destination="@+id/nav_graph_product_edit"
        app:enterAnim="@anim/anim_slide_in_right"
        app:exitAnim="@anim/anim_slide_out_left"
        app:popEnterAnim="@anim/anim_slide_in_left"
        app:popExitAnim="@anim/anim_slide_out_right">

        <argument
            android:name="productId"
            app:argType="string" />

        <argument
            android:name="isCreateMode"
            app:argType="boolean" />
    </action>

    <action
        android:id="@+id/action_to_brand_edit"
        app:destination="@id/nav_graph_brand_edit"
        app:enterAnim="@anim/anim_slide_in_right"
        app:exitAnim="@anim/anim_slide_out_left"
        app:popEnterAnim="@anim/anim_slide_in_left"
        app:popExitAnim="@anim/anim_slide_out_right">

        <argument
            android:name="brandId"
            app:argType="string" />

        <argument
            android:name="isCreateMode"
            app:argType="boolean" />
    </action>

    <action
        android:id="@+id/action_to_category_edit"
        app:destination="@id/nav_graph_category_edit"
        app:enterAnim="@anim/anim_slide_in_right"
        app:exitAnim="@anim/anim_slide_out_left"
        app:popEnterAnim="@anim/anim_slide_in_left"
        app:popExitAnim="@anim/anim_slide_out_right">

        <argument
            android:name="categoryId"
            app:argType="string" />

        <argument
            android:name="isCreateMode"
            app:argType="boolean" />
    </action>

    <fragment
        android:id="@+id/productTabHostFragment"
        android:name="com.optlab.banhangso.features.main.product.views.ProductTabHostFragment"
        tools:layout="@layout/fragment_product_tab_host" />

    <fragment
        android:id="@+id/categoryListFragment"
        android:name="com.optlab.banhangso.features.main.category.view.CategoryListFragment"
        tools:layout="@layout/fragment_category_list" />

    <fragment
        android:id="@+id/brandListFragment"
        android:name="com.optlab.banhangso.features.main.brand.view.BrandListFragment"
        tools:layout="@layout/fragment_brand_list" />

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.optlab.banhangso.features.main.product.views.ProductListFragment"
        tools:layout="@layout/fragment_product_list" />

    <dialog
        android:id="@+id/productSortSelectionFragment"
        android:name="com.optlab.banhangso.features.main.product.views.ProductSortSelectionFragment"
        tools:layout="@layout/list_item_sort_selection" />

    <dialog
        android:id="@+id/brandSortSelectionFragment"
        android:name="com.optlab.banhangso.features.main.brand.view.BrandSortSelectionFragment"
        tools:layout="@layout/list_item_sort_selection" />

    <dialog
        android:id="@+id/categorySortSelectionFragment"
        android:name="com.optlab.banhangso.features.main.category.view.CategorySortSelectionFragment"
        tools:layout="@layout/list_item_sort_selection" />

</navigation>

