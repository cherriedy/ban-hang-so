<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customer_navigation"
    app:startDestination="@id/customerListFragment">

    <fragment
        android:id="@+id/customerListFragment"
        android:name="com.optlab.banhangso.features.main.customer.views.CustomerListFragment"
        android:label="CustomerListFragment"
        tools:layout="@layout/fragment_customer_list">

        <deepLink app:uri="app://banhangso/customer/list" />

        <action
            android:id="@+id/action_to_edit"
            app:destination="@id/customerEditFragment"
            app:enterAnim="@anim/anim_slide_in_right"
            app:exitAnim="@anim/anim_slide_out_left"
            app:popEnterAnim="@anim/anim_slide_in_left"
            app:popExitAnim="@anim/anim_slide_out_right">

            <argument
                android:name="customerId"
                app:argType="string" />

            <argument
                android:name="isEditing"
                android:defaultValue="true"
                app:argType="boolean" />
        </action>

        <action
            android:id="@+id/action_to_create"
            app:destination="@id/customerEditFragment"
            app:enterAnim="@anim/anim_slide_in_right"
            app:exitAnim="@anim/anim_slide_out_left"
            app:popEnterAnim="@anim/anim_slide_in_left"
            app:popExitAnim="@anim/anim_slide_out_right">

            <argument
                android:name="customerId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />

            <argument
                android:name="isEditing"
                android:defaultValue="false"
                app:argType="boolean" />
        </action>

        <action
            android:id="@+id/action_to_edit_with_parcelable"
            app:destination="@id/customerEditFragment"
            app:enterAnim="@anim/anim_slide_in_right"
            app:exitAnim="@anim/anim_slide_out_left"
            app:popEnterAnim="@anim/anim_slide_in_left"
            app:popExitAnim="@anim/anim_slide_out_right">

            <argument
                android:name="customer"
                app:argType="com.optlab.banhangso.features.main.customer.models.CustomerUiModel" />

            <argument
                android:name="isEditing"
                android:defaultValue="false"
                app:argType="boolean" />
        </action>

    </fragment>

    <fragment
        android:id="@+id/customerEditFragment"
        android:name="com.optlab.banhangso.features.main.customer.views.CustomerEditFragment"
        android:label="CustomerEditFragment"
        tools:layout="@layout/fragment_customer_edit">

        <deepLink app:uri="app://banhangso/customer/edit/{customerId}" />
        <deepLink app:uri="app://banhangso/customer/create" />

        <argument
            android:name="customerId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="isEditing"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="customer"
            android:defaultValue="@null"
            app:argType="com.optlab.banhangso.features.main.customer.models.CustomerUiModel"
            app:nullable="true" />

    </fragment>

</navigation>